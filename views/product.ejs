<%- include('partials/head', { description: (product.description || product.note || product.title).slice(0, 160) }) %>
<%- include('partials/header') %>

<nav class="container breadcrumb" aria-label="Ruta de navegación">
  <a href="/">Inicio</a>
  <span aria-hidden="true">›</span>
  <a href="/?categoria=<%= encodeURIComponent(product.category) %>#productos"><%= product.category %></a>
  <span aria-hidden="true">›</span>
  <span><%= product.title %></span>
</nav>

<section class="container product-layout">
  <div class="gallery">
    <div class="gallery-main">
      <% if (product.images.length) { %>
        <img id="main-photo" src="<%= product.images[0].url %>" alt="<%= product.title %>">
      <% } else { %>
        <%- include('partials/icon', { name: 'image', size: 72, color: '#3E7CB1', sw: 1.25 }) %>
      <% } %>
    </div>
    <% if (product.images.length > 1) { %>
      <div class="thumbs">
        <% product.images.forEach(function (img, i) { %>
          <a class="thumb<%= i === 0 ? ' active' : '' %>" href="<%= img.url %>" target="_blank" rel="noopener" data-thumb aria-label="Ver foto <%= i + 1 %>">
            <img src="<%= img.thumb_url || img.url %>" alt="" loading="lazy">
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="product-info">
    <div class="panel">
      <div class="chips">
        <span class="badge badge-inline"><%= product.item_condition %></span>
        <%- include('partials/status-chip', { status: product.status }) %>
      </div>
      <h1><%= product.title %></h1>
      <div class="price"><%= money(product.price) %></div>

      <% if (product.status === 'vendido') { %>
        <p class="sold-note">Este producto ya fue vendido. Puedes ver lo que tengo disponible ahora.</p>
        <a class="btn btn-primary btn-lg" href="/#productos">Ver productos disponibles</a>
      <% } else { %>
        <a class="btn btn-wa btn-lg" href="<%= whatsappUrl %>" target="_blank" rel="noopener">
          <%- include('partials/icon', { name: 'chat', size: 20, color: '#FFFFFF', sw: 2 }) %>
          <%= product.status === 'reservado' ? 'Escríbeme por si se libera' : 'Comprar por WhatsApp' %>
        </a>
        <p class="hint">
          <%= product.status === 'reservado'
            ? 'Está reservado por otra persona. Si la compra no se concreta, te aviso.'
            : 'Te respondo directo para coordinar el pago y la entrega.' %>
        </p>
      <% } %>
    </div>

    <div class="panel">
      <h2 class="panel-title">Detalles del producto</h2>
      <dl class="details">
        <div><dt>Condición</dt><dd><%= product.item_condition %></dd></div>
        <div><dt>Categoría</dt><dd><%= product.category %></dd></div>
        <% if (product.includes) { %><div><dt>Incluye</dt><dd><%= product.includes %></dd></div><% } %>
        <div><dt>Publicado</dt><dd><%= new Date(product.created_at.replace(' ', 'T') + 'Z').toLocaleDateString(cfg.LOCALE, { day: 'numeric', month: 'long', year: 'numeric' }) %></dd></div>
      </dl>
    </div>

    <div class="panel">
      <h2 class="panel-title">Compra con tranquilidad</h2>
      <ul class="checks">
        <li><%- include('partials/icon', { name: 'check', size: 20, color: '#17703E', sw: 2 }) %><span>Fotos reales del producto que recibirás.</span></li>
        <li><%- include('partials/icon', { name: 'check', size: 20, color: '#17703E', sw: 2 }) %><span>Estado descrito con honestidad, incluidos los detalles.</span></li>
        <li><%- include('partials/icon', { name: 'check', size: 20, color: '#17703E', sw: 2 }) %><span>Pago y entrega coordinados directamente conmigo.</span></li>
      </ul>
      <a class="text-link" href="/envios">Ver envíos, pagos y devoluciones</a>
    </div>
  </div>
</section>

<% if (product.description || product.flaws) { %>
<section class="container section">
  <div class="panel panel-wide">
    <% if (product.description) { %>
      <h2 class="panel-title">Descripción</h2>
      <p class="prose"><%= product.description %></p>
    <% } %>
    <% if (product.flaws) { %>
      <h2 class="panel-title spaced">Detalles a considerar</h2>
      <p class="prose"><%= product.flaws %></p>
    <% } %>
  </div>
</section>
<% } %>

<% if (related.length) { %>
<section class="container section section-last">
  <h2>Más productos</h2>
  <div class="grid-products">
    <% related.forEach(function (p) { %>
      <%- include('partials/card', { p: p }) %>
    <% }) %>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
