# Copia este archivo como ".env" para trabajar en tu computador y completa los valores.
# En Vercel NO se sube este archivo: las mismas variables se definen en
# Project Settings > Environment Variables.

# Contraseña para entrar al panel de administración (/admin). Mínimo 8 caracteres.
ADMIN_PASSWORD=cambia-esta-contraseña

# Clave para firmar las sesiones: una cadena larga y aleatoria (mínimo 16 caracteres).
# Obligatoria en Vercel. Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Puerto donde corre la tienda en tu computador.
PORT=3000

# Dirección pública de tu tienda, sin barra final. Se usa en el mensaje de WhatsApp.
# BASE_URL=https://mitienda.vercel.app

# Formato de precios (opcional).
# LOCALE=es-CL
# CURRENCY=CLP

# --- Solo en Vercel (las crean las integraciones; no las escribas a mano) ---
# TURSO_DATABASE_URL=   (integración Turso del Marketplace)
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=   (almacén Blob de la pestaña Storage)
#
# Sin estas variables, la tienda funciona en tu computador con un archivo local
# (carpeta data/) para la base de datos y las fotos.
